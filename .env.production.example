# Production environment template for MkulimaLink
# Copy to .env.production and fill in real values before deploying

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://mkulimalink.vercel.app

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mkulimalink?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change_to_a_long_random_string_in_production
JWT_EXPIRE=30d

# Security
CORS_ORIGINS=https://mkulimalink.vercel.app,https://www.mkulimalink.com
WEBHOOK_SECRET=your_webhook_secret_for_callbacks

# Seed Configuration
SEED_SECRET=mkulima-seed-2024
SEED_ON_START=false

# Push Notifications (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:push@mkulimalink.com

# M-Pesa Integration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_business_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
MPESA_ENV=production

# SMS - Africa's Talking
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_SENDER_ID=MkulimaLink

# Exchange Rate API - get free key at https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=your_exchangerate_api_key

# Weather API
TMA_API_KEY=your_tma_weather_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=af-south-1
AWS_S3_BUCKET_NAME=mkulimalink-uploads
AWS_CLOUDFRONT_URL=https://cdn.example.com

# ClickPesa Integration
CLICKPESA_CLIENT_ID=your_clickpesa_client_id
CLICKPESA_API_KEY=your_clickpesa_api_key
CLICKPESA_BASE_URL=https://api.clickpesa.com

# Business Configuration
COMMISSION_RATE=0.05
PREMIUM_MONTHLY_PRICE=10000
PREMIUM_YEARLY_PRICE=100000
LOAN_ORIGINATION_FEE=0.02
DELIVERY_BASE_PRICE=2000

# Insurance Partner
INSURANCE_PARTNER_API=your_insurance_partner_api
INSURANCE_PARTNER_KEY=your_insurance_key

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id
MIXPANEL_TOKEN=your_mixpanel_token

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
